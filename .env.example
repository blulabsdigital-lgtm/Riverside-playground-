# Template for .env.local (the private copy, which git ignores).
# Variable names only. Never put real keys in this file.

# Google AI Studio key (Nano Banana), used to make materials from Alex's photos.
GEMINI_API_KEY=

# Optional. A Supabase personal access token lets Claude create the separate
# riverside-playground project and deploy the kitchen engine for you.
# It gives full access to your Supabase account, so only add it if you want that.
# SUPABASE_ACCESS_TOKEN=
